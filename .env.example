# FREE accounts only. Copy to .env; never paste keys into chat.
# Groq Free plan; no billing/upgrade. Tavily Researcher/Free, Development key, PAYGO disabled.
GROQ_API_KEY=
TAVILY_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Legacy cumulative project limits, NOT provider daily quotas. Never reset history.
# New-run approvals are separate ledger entries; see docs/APPROVED_CONTINUATION.md.
PROJECT_MAX_GROQ_TOKENS=40000
PROJECT_MAX_TAVILY_CREDITS=40
GROQ_TPM=8000
GROQ_RPM=25
MAX_REQUEST_TOKENS=7500
MAX_OUTPUT_TOKENS=2600
TIMEOUT_SECONDS=90
MAX_RETRIES=0
RATE_SAFETY_MARGIN=0.9
MAX_RETRY_AFTER_SECONDS=90
MAX_API_REQUESTS=24
MAX_TOTAL_INPUT_TOKENS=65000
MAX_TOTAL_OUTPUT_TOKENS=35000
MAX_SEARCH_REQUESTS=10
MAX_EXTRACT_REQUESTS=5
MAX_TAVILY_CREDITS=16
TAVILY_RPM=30
MAX_RESULTS_PER_QUERY=3
MAX_SOURCE_FETCHES=15
MAX_SOURCE_CHARS=12000
EVIDENCE_CHARS_PER_SOURCE=1800
EVIDENCE_CHARS_PER_REQUEST=6000
RUNS_DIR=runs
# One research synthesis request rather than separate Groq calls per research topic.
COMPACT_ACCOUNT_RESEARCH=true
# Optional: set these only if your Groq Limits page shows an input/output TPM breakdown.
# These are local scheduler limits, never request parameters or provider quota changes.
# GROQ_INPUT_TPM=4000
# GROQ_OUTPUT_TPM=4000
